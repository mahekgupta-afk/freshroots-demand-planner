# Neon pooled connection string (full-access: server only, never commit)
DATABASE_URL=
GEMINI_API_KEY=
# Pinned model name, not a -latest alias. See docs/ASSUMPTIONS.md item 24.
GEMINI_MODEL=gemini-3.5-flash
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/inventory/v1
CRON_SECRET=
RESEND_API_KEY=
# Sender must be on a domain verified in Resend (or onboarding@resend.dev for testing to your own address)
NOTIFY_FROM=
# Run summary after each scheduled run: Raghav + procurement, comma separated
NOTIFY_EMAILS=
# Failure alerts: admin + IT lead. Falls back to NOTIFY_EMAILS if empty.
ALERT_EMAILS=
# Public site address for links in emails (defaults to the Vercel production URL)
APP_URL=

AUTH_SECRET=
